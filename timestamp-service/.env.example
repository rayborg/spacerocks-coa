# Safe template only. Copy to an untracked .env and replace local placeholders there.
# The application does not automatically load this file; export it deliberately.
APP_ENV=local
PAYMENT_MODE=disabled
CHECKOUT_ENABLED=false
CALENDAR_MODE=disabled
BITCOIN_VERIFIER=disabled
RESEND_SENDER_MODE=disabled
RESEND_WEBHOOK_MODE=disabled
ALLOWED_ORIGINS=[]

# Local Compose placeholders. Generate unique local values; never commit the result.
POSTGRES_DB=timestamp_local
POSTGRES_USER=timestamp_local
POSTGRES_PASSWORD=replace-with-a-random-local-only-value

# Token configuration is required when payments are enabled and may be used for local readiness.
# TOKEN_PEPPERS__1=replace-with-at-least-32-random-bytes
# ACTIVE_TOKEN_PEPPER_VERSION=1
# TOKEN_TTL_SECONDS=2592000
# CHECKOUT_CREDENTIAL_GRACE_SECONDS=60

# PostgreSQL target. Use only a local disposable URL here; Neon belongs in the deployment secret store.
# DATABASE_URL=postgresql+psycopg://timestamp_local:local-password@127.0.0.1:5432/timestamp_local

# Stripe stays disabled unless an owner-authorized environment supplies one matching mode.
# STRIPE_TEST_ENABLED=false
# STRIPE_LIVE_ENABLED=false
# STRIPE_SECRET_KEY=replace-in-secret-store
# STRIPE_WEBHOOK_SECRET=replace-in-secret-store
# STRIPE_PRICE_ID=price_replace
# CHECKOUT_AMOUNT_MINOR=500
# CHECKOUT_CURRENCY=usd
# PRODUCT_VERSION=replace-with-reviewed-version
# EXPECTED_TERMS_VERSION=replace-with-reviewed-policy-version
# EXPECTED_PRIVACY_VERSION=replace-with-reviewed-policy-version
# CHECKOUT_SUCCESS_URL=https://frontend.example/status
# CHECKOUT_CANCEL_URL=https://frontend.example/cancel
# STRIPE_AUTOMATIC_TAX_ENABLED=false
# STRIPE_SIGNATURE_TOLERANCE_SECONDS=300
# STRIPE_API_TIMEOUT_SECONDS=10

# Public calendars require CALENDAR_MODE=public, staging/production, and at least two HTTPS hosts.
# CALENDAR_ALLOWLIST=["https://calendar-one.example/","https://calendar-two.example/"]
# CALENDAR_TIMEOUT_SECONDS=5

# Bitcoin Core requires BITCOIN_VERIFIER=bitcoin_core and a private authenticated RPC endpoint.
# BITCOIN_RPC_URL=http://private-bitcoin-rpc:8332/
# BITCOIN_RPC_USERNAME=replace-in-secret-store
# BITCOIN_RPC_PASSWORD=replace-in-secret-store
# BITCOIN_RPC_TIMEOUT_SECONDS=5

# Resend sender and webhook are independent explicit gates.
# RESEND_API_KEY=replace-in-secret-store
# RESEND_SENDER="Timestamp Service <timestamp@example.com>"
# RESEND_API_TIMEOUT_SECONDS=10
# RESEND_WEBHOOK_SECRET=replace-in-secret-store
# RESEND_WEBHOOK_TOLERANCE_SECONDS=300

# Proxy and application limits. Values shown are source defaults.
# TRUSTED_PROXY_IPS=[]
# CHECKOUT_RATE_LIMIT=10
# WEBHOOK_RATE_LIMIT=120
# RESEND_WEBHOOK_RATE_LIMIT=120
# STATUS_RATE_LIMIT=60
# PROOF_RATE_LIMIT=20
# ROTATION_RATE_LIMIT=5

# Process-only factory settings; set on the corresponding worker/operator service.
# TIMESTAMP_WORKER_FACTORY=app.worker.composition:create_worker
# TIMESTAMP_WORKER_ID=timestamp-worker-1
# NOTIFICATION_WORKER_FACTORY=app.notifications.worker:create_notification_worker
# NOTIFICATION_WORKER_ID=notification-worker-1
# TIMESTAMP_OPERATOR_FACTORY=app.worker.operator:create_operator_commands
