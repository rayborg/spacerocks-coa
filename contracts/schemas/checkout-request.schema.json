{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spacerocks.example/contracts/checkout-request.schema.json",
  "title": "Phase 0 timestamp checkout request",
  "type": "object",
  "additionalProperties": false,
  "required": ["certificate_reference", "manifest_sha256", "email", "consent"],
  "properties": {
    "certificate_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managed_timestamp", "terms_version", "privacy_version", "accepted_at"],
      "properties": {
        "managed_timestamp": {"const": true},
        "terms_version": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9._-]+$"},
        "privacy_version": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9._-]+$"},
        "accepted_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
